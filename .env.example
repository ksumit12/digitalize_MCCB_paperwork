# Copy to .env.local and fill in. .env.local is gitignored; never commit a real
# value. Production values live in the Vercel dashboard, not in this repo.

# Neon connection string. Use the POOLED host (the one containing "-pooler"),
# so short-lived serverless functions reuse connections instead of opening a
# new one per request.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Leave DATABASE_URL unset to fall back to a local SQLite file at ./data.
# That database is private to this machine and shares nothing with your phone.

# Shared crew passcode. Gates the whole app, including /api/data.
# Leave unset for local work; the gate turns itself off and the sync stats
# panel shows "Access: OPEN". Always set this on the deployed app.
APP_PASSCODE=

# Also recognised, in this order, if DATABASE_URL is absent:
#   POSTGRES_URL, POSTGRES_PRISMA_URL, NEON_DATABASE_URL,
#   STORAGE_URL, STORAGE_DATABASE_URL
